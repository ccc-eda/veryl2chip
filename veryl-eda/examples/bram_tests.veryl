// Block RAM inference tests: SyncRam (examples/src/sync_ram.veryl) in every
// iCE40 RAM mode, a word wider than one block, and two read ports.

module Bram256x16 (
    i_clk  : input  clock,
    i_we   : input  logic,
    i_waddr: input  logic<8>,
    i_wdata: input  logic<16>,
    i_re   : input  logic,
    i_raddr: input  logic<8>,
    o_rdata: output logic<16>,
) {
    inst u: SyncRam #(ADDR_W: 8, DATA_W: 16) (
        i_clk,
        i_we,
        i_waddr,
        i_wdata,
        i_re,
        i_raddr,
        o_rdata,
    );
}

