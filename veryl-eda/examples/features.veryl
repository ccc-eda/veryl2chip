// veryl-eda feature coverage: every module here is checked for formal
// equivalence against `veryl build` output by test.sh
package FeatPkg {
    const ONES: logic<4> = 4'hf;
    struct Pair {
        hi: logic<4>,
        lo: logic<4>,
    }
}

module Shifter #(
    param W: u32 = 8,
) (
    i_a  : input  logic<W>,
    i_n  : input  logic<3>,
    i_op : input  logic<2>,
    o_y  : output logic<W>,
    o_sl : output logic<4>,
) {
    always_comb {
        switch {
            i_op == 2'd0: o_y = i_a << i_n;
            i_op == 2'd1: o_y = i_a >> i_n;
            i_op == 2'd2: o_y = $signed(i_a) >>> i_n;
            default     : o_y = {i_a[3:0], i_a[W - 1:4]};
        }
    }
    assign o_sl = i_a[i_n+:4];
}

module Funcs (
    i_x : input  logic<8>,
    i_k : input  logic<8>,
    o_c : output logic<4>,
    o_r : output logic<4>,
    o_m : output logic<16>,
    o_p : output FeatPkg::Pair,
) {
    function popcnt (
        x: input logic<8>,
    ) -> logic<4> {
        var n: logic<4>;
        n = 0;
        for i in 0..8 {
            n += x[i];
        }
        return n;
    }

    function clamp (
        v: input logic<8>,
    ) -> logic<4> {
        if v >= 8'd15 {
            return 4'd15;
        }
        if v == 8'd0 {
            return 4'd1;
        }
        return v[3:0];
    }

    assign o_c = popcnt(i_x);
    assign o_r = clamp(i_k);
    assign o_m = i_x * i_k;
    always_comb {
        o_p.hi = i_x[7:4] ^ FeatPkg::ONES;
        o_p.lo = if &i_k[1:0] ? i_x[3:0] : ~i_x[3:0];
    }
}

module Ranges (
    i_v : input  logic<6>,
    o_cl: output logic<2>,
    o_rv: output logic<6>,
) {
    always_comb {
        case i_v {
            0..10  : o_cl = 2'd0;
            10..=20: o_cl = 2'd1;
            21, 22 : o_cl = 2'd2;
            default: o_cl = 2'd3;
        }
    }
    for i in 0..6 : g {
        if i % 2 == 0 : even {
            assign o_rv[i] = i_v[5 - i];
        } else {
            assign o_rv[i] = ~i_v[5 - i];
        }
    }
}

module Counter #(
    param INIT: u32 = 5,
) (
    i_clk: input  clock_negedge,
    i_rst: input  reset_sync_high,
    i_en : input  logic,
    o_q  : output logic<4>,
) {
    var cnt: logic<4>;
    always_ff {
        if_reset {
            cnt = INIT;
        } else if i_en {
            cnt += 1;
        }
    }
    assign o_q = cnt;
}

module Top (
    i_clk: input  clock_negedge,
    i_rst: input  reset_sync_high,
    i_en : input  logic,
    o_a  : output logic<4>,
    o_b  : output logic<4>,
) {
    inst c0: Counter #(INIT: 3) (
        i_clk,
        i_rst,
        i_en ,
        o_q  : o_a,
    );
    inst c1: Counter (
        i_clk,
        i_rst,
        i_en : ~i_en,
        o_q  : o_b,
    );
}

// ---------------- testbenches (veryl test / veryl-sim) ----------------

#[test(test_shifter)]
module TestShifter {
    var a : logic<8>;
    var n : logic<3>;
    var op: logic<2>;
    var y : logic<8>;
    var sl: logic<4>;

    inst u: Shifter #(W: 8) (
        i_a : a ,
        i_n : n ,
        i_op: op,
        o_y : y ,
        o_sl: sl,
    );

    initial {
        a  = 8'h96;
        n  = 3'd3;
        op = 2'd0;
        $assert(y == 8'hb0, "<<");
        op = 2'd1;
        $assert(y == 8'h12, ">>");
        op = 2'd2;
        $assert(y == 8'hf2, ">>> keeps the sign");
        op = 2'd3;
        $assert(y == 8'h69, "nibble swap");
        $assert(sl == 4'h2, "variable +: slice");
        n = 3'd0;
        $assert(sl == 4'h6, "+: slice at 0");
        $finish();
    }
}

#[test(test_funcs)]
module TestFuncs {
    var x: logic<8>;
    var k: logic<8>;
    var c: logic<4>;
    var r: logic<4>;
    var m: logic<16>;
    var p: FeatPkg::Pair;

    inst u: Funcs (
        i_x: x,
        i_k: k,
        o_c: c,
        o_r: r,
        o_m: m,
        o_p: p,
    );

    initial {
        x = 8'hb5;
        k = 8'd20;
        $assert(c == 4'd5, "popcount");
        $assert(r == 4'd15, "clamp high");
        $assert(m == 16'd3620, "multiply");
        $assert(p == 8'h4a, "struct fields");
        k = 8'd3;
        $assert(r == 4'd3, "clamp pass-through");
        $assert(m == 16'd543, "multiply 2");
        $assert(p.lo == 4'h5, "struct field read");
        k = 8'd0;
        $assert(r == 4'd1, "clamp zero");
        $finish();
    }
}

#[test(test_ranges)]
module TestRanges {
    var v : logic<6>;
    var cl: logic<2>;
    var rv: logic<6>;

    inst u: Ranges (
        i_v : v ,
        o_cl: cl,
        o_rv: rv,
    );

    initial {
        v = 6'd0;
        $assert(cl == 2'd0, "0 in 0..10");
        $assert(rv == 6'h2a, "reverse, odd bits inverted (0)");
        v = 6'd9;
        $assert(cl == 2'd0, "9 in 0..10");
        v = 6'd10;
        $assert(cl == 2'd1, "10 in 10..=20");
        v = 6'd20;
        $assert(cl == 2'd1, "20 in 10..=20");
        v = 6'd22;
        $assert(cl == 2'd2, "22 listed");
        v = 6'd23;
        $assert(cl == 2'd3, "23 default");
        v = 6'h3f;
        $assert(rv == 6'h15, "reverse, odd bits inverted (all ones)");
        v = 6'h20;
        $assert(rv == 6'h2b, "reverse, odd bits inverted (msb)");
        $finish();
    }
}

#[test(test_counters)]
module TestCounters {
    inst clk: $tb::clock_gen;

    var rst: reset_sync_high;
    var en : logic;
    var a  : logic<4>;
    var b  : logic<4>;

    inst u: Top (
        i_clk: clk,
        i_rst: rst,
        i_en : en ,
        o_a  : a  ,
        o_b  : b  ,
    );

    initial {
        rst = 1;
        en  = 1;
        clk.next(2);
        $assert(a == 4'd3, "c0 reset value (INIT = 3)");
        $assert(b == 4'd5, "c1 reset value (INIT = 5)");
        rst = 0;
        clk.next(4);
        $assert(a == 4'd7, "c0 counts while enabled");
        $assert(b == 4'd5, "c1 holds while disabled");
        en = 0;
        clk.next(3);
        $assert(a == 4'd7, "c0 holds");
        $assert(b == 4'd8, "c1 counts");
        $finish();
    }
}
