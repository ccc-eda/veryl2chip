# Linux for Rv64Soc: added to tinyconfig (RV64IMAC, Sv39, one hart, no FPU, initramfs only)
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ISA_ZACAS=n
CONFIG_RISCV_ISA_ZABHA=n
CONFIG_NONPORTABLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BINFMT_ELF=y
# busybox: /init is a shell script, users / groups, futexes, timers, tmpfs on /tmp
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SIFIVE_PLIC=y
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_BLOCK=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_STACKPROTECTOR=n
CONFIG_RELOCATABLE=n
CONFIG_EFI=n
CONFIG_SERIO=n
CONFIG_HID_SUPPORT=n
CONFIG_HID=n
# GPIO (v2.15): Rv64Gpio is SiFive-compatible; board LEDs through gpio-leds, the legacy
# sysfs interface (/sys/class/gpio) and the character device for user programs
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_SIFIVE=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_SYSFS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
# files to and from the IDE: getfiles / savefiles read and write the exchange area (/dev/mem)
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
# the screen (v2.21): simple-framebuffer (/dev/fb0) with the framebuffer console on tty1
# (the kernel's console stays on the serial port; no cursor: vt.global_cursor_default=0)
CONFIG_VT=y
CONFIG_INPUT=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=n
CONFIG_LOGO=n
