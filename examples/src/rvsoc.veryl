// ==========================================
// 多週期 RISC-V SoC：程式、資料與暫存器檔都放在 block RAM
// ==========================================
// 單週期的 RiscvCore（rv32i.veryl）把 32 個暫存器做成正反器，完整版需要
// 5,400 個 LUT，放不進 iCE40UP5K。這裡的 RvCore 改成多週期：
//   Fetch  → 送出 pc 的讀取位址（只在重設後與 load 之後）
//   Decode → 記憶體讀出指令，同一拍用它的 rs1 / rs2 讀暫存器檔
//   Exec   → 運算、寫回、算下一個 pc 並且立刻送出它的讀取位址（store 同時寫入）
//   Mem    → load：記憶體讀出資料，寫回，送出 pc 的讀取位址
// 一般指令 2 拍、load 3 拍。暫存器檔與記憶體都是同步讀取（下一拍才有資料），
// RV32IMA + Zicsr：乘除法（反覆式，35 拍）、原子指令（LR / SC、AMO 3 拍）、
// machine mode 的陷阱（中斷、ecall、ebreak、非法指令、位址沒對齊；陷入多 1 拍）、mret、wfi；
// 這些足夠跑搶佔式的多執行緒作業系統（計時器中斷切換執行緒）。
// 合成到 FPGA 時變成 SB_RAM40_4K。需要 rv32i.veryl（RiscvTypes、Alu）、
// sync_ram.veryl（SyncRam）與 uart.veryl（UartTx、UartRx）。
//
// 記憶體映射（位址 bit 28 = 1 是周邊）：
//   0x0000_0000  8 KB RAM（程式與資料，RvSoc 的 MEM_AW 決定大小）
//   0x1000_0000  LED      讀寫，8 bit
//   0x1000_0004  BTN      讀：bit 2..0 = BTN3..BTN1，bit 15..8 = PMOD1B 的 8 個開關
//   0x1000_0008  UART     寫：送出一個位元組；讀：收到的位元組（讀了就清掉 RXV）
//   0x1000_000C  UART_ST  讀：bit 0 = TX 忙碌，bit 1 = RXV（有收到的位元組）
//   0x1000_0010  MTIME    讀寫：重設後經過的時脈數（32 bit，12 MHz 下約 357 秒繞一圈；0x14 高位元讀 0）
//   0x1000_0018  MTIMECMP 讀寫：mtime ≥ mtimecmp 時計時器中斷（重設後是全 1；0x1C 高位元讀 0）
//   0x1000_0020  MSIP     讀寫：bit 0 = 軟體中斷
//   中斷：計時器 → mip.MTIP，MSIP → mip.MSIP，UART 收到位元組（RXV）→ mip.MEIP
//   0x1000_2000 以上     寫到外部匯流排 o_x*（例如 VgaText：0x1000_2000 字元、0x1000_4000 字型、0x1000_6000 顏色）

module RvCore (
    i_clk      : input  clock    ,
    i_rst      : input  reset    ,
    i_run      : input  logic    , // 0：停在 pc = 0（載入程式時）
    o_raddr    : output logic<32>, // 讀取位址（取指令或 load），下一拍 i_rdata 才有資料
    o_re       : output logic    ,
    i_rdata    : input  logic<32>,
    o_waddr    : output logic<32>, // 寫入位址（store）
    o_wstrb    : output logic<4> , // 要寫的位元組；0 = 不寫
    o_wdata    : output logic<32>,
    i_irq_timer: input  logic    , // mtime ≥ mtimecmp（mip.MTIP）
    i_irq_soft : input  logic    , // msip（mip.MSIP）
    i_irq_ext  : input  logic    , // 外部（UART 收到位元組，mip.MEIP）
    i_mtime    : input  logic<64>, // time CSR
) {
    import RiscvTypes::*;

    const FETCH : logic<3> = 3'd0;
    const DECODE: logic<3> = 3'd1;
    const EXEC  : logic<3> = 3'd2;
    const MEM   : logic<3> = 3'd3;
    const MULDIV: logic<3> = 3'd4;
    const WFI   : logic<3> = 3'd5;

    var state : logic<3> ;
    var pc    : logic<32>;
    var ir    : logic<32>; // 執行中的指令
    var lsaddr: logic<32>; // load / AMO 的位址（Mem 用）

    // Decode 那一拍指令還在 i_rdata 上，之後在 ir
    let cur: logic<32> = if state == DECODE ? i_rdata : ir;

    let opcode : logic<7> = ir[6:0];
    let rd_idx : logic<5> = ir[11:7];
    let funct3 : logic<3> = ir[14:12];
    let rs1_idx: logic<5> = ir[19:15];
    let funct7 : logic<7> = ir[31:25];
    let funct5 : logic<5> = ir[31:27];

    // --- 暫存器檔：兩份相同的同步讀取 RAM（兩個讀取埠），一起寫入 ---
    var rf_we  : logic    ;
    var rf_wd  : logic<32>;
    var rs1_raw: logic<32>;
    var rs2_raw: logic<32>;

    inst u_rf1: SyncRam #(ADDR_W: 5, DATA_W: 32) (
        i_clk  : i_clk      ,
        i_we   : rf_we      ,
        i_waddr: rd_idx     ,
        i_wdata: rf_wd      ,
        i_re   : 1'b1       ,
        i_raddr: cur[19:15] ,
        o_rdata: rs1_raw    ,
    );
    inst u_rf2: SyncRam #(ADDR_W: 5, DATA_W: 32) (
        i_clk  : i_clk      ,
        i_we   : rf_we      ,
        i_waddr: rd_idx     ,
        i_wdata: rf_wd      ,
        i_re   : 1'b1       ,
        i_raddr: cur[24:20] ,
        o_rdata: rs2_raw    ,
    );

    // x0 永遠是 0（RAM 裡的 x0 從來不寫，但模擬時一開始是 x）；是不是 x0 在 Decode 就先判斷
    var rs1_zero: logic;
    var rs2_zero: logic;
    let rs1_data: logic<32> = if rs1_zero ? 32'd0 : rs1_raw;
    let rs2_data: logic<32> = if rs2_zero ? 32'd0 : rs2_raw;

    // --- 指令分類 ---
    let op_load  : logic = opcode == Opcode::Load;
    let op_store : logic = opcode == Opcode::Store;
    let op_system: logic = opcode == 7'b1110011;
    let op_amo   : logic = opcode == 7'b0101111;
    let muldiv   : logic = opcode == Opcode::RType && funct7 == 7'b0000001;
    let is_lr    : logic = op_amo && funct5 == 5'b00010;
    let is_sc    : logic = op_amo && funct5 == 5'b00011;
    let is_amo   : logic = op_amo && !is_lr && !is_sc; // 讀、改、寫
    let is_ecall : logic = ir == 32'h0000_0073;
    let is_ebreak: logic = ir == 32'h0010_0073;
    let is_mret  : logic = ir == 32'h3020_0073;
    let is_wfi   : logic = ir == 32'h1050_0073;
    let is_csr   : logic = op_system && funct3 != 3'd0 && funct3 != 3'd4;

    // --- 立即數：Decode 那一拍從讀出的指令解出來，存進 imm（Exec 不用再解碼）---
    let c_op : logic<7> = cur[6:0];
    var imm_d: logic<32>;
    always_comb {
        case c_op {
            Opcode::IType, Opcode::Load, Opcode::Jalr:
                imm_d = {cur[31] repeat 20, cur[31:20]};
            Opcode::Store:
                imm_d = {cur[31] repeat 20, cur[31:25], cur[11:7]};
            Opcode::Branch:
                imm_d = {cur[31] repeat 20, cur[7], cur[30:25], cur[11:8], 1'b0};
            Opcode::Jal:
                imm_d = {cur[31] repeat 12, cur[19:12], cur[20], cur[30:21], 1'b0};
            Opcode::Lui, Opcode::Auipc:
                imm_d = {cur[31:12], 12'd0};
            default:
                imm_d = 32'd0; // AMO / LR / SC：位址就是 rs1
        }
    }
    var imm: logic<32>;

    // --- ALU 運算 ---
    let alt: logic = funct7[5] && (opcode == Opcode::RType || funct3 == 3'b101);
    var alu_op: AluOp;
    always_comb {
        if opcode == Opcode::RType || opcode == Opcode::IType {
            case funct3 {
                3'b000 : alu_op = if alt ? AluOp::Sub : AluOp::Add;
                3'b001 : alu_op = AluOp::Sll;
                3'b010 : alu_op = AluOp::Slt;
                3'b011 : alu_op = AluOp::Sltu;
                3'b100 : alu_op = AluOp::Xor;
                3'b101 : alu_op = if alt ? AluOp::Sra : AluOp::Srl;
                3'b110 : alu_op = AluOp::Or;
                default: alu_op = AluOp::And;
            }
        } else {
            alu_op = AluOp::Add; // 位址計算
        }
    }

    let alu_b: logic<32> = if opcode == Opcode::RType || opcode == Opcode::Branch ? rs2_data : imm;
    var alu_out: logic<32>;
    inst u_alu: Alu (
        i_op : alu_op  ,
        i_a  : rs1_data,
        i_b  : alu_b   ,
        o_res: alu_out ,
    );

    // --- 分支條件 ---
    var take: logic;
    always_comb {
        case funct3 {
            3'b000 : take = rs1_data == rs2_data;
            3'b001 : take = rs1_data != rs2_data;
            3'b100 : take = $signed(rs1_data) <: $signed(rs2_data);
            3'b101 : take = $signed(rs1_data) >= $signed(rs2_data);
            3'b110 : take = rs1_data <: rs2_data;
            3'b111 : take = rs1_data >= rs2_data;
            default: take = 1'b0;
        }
    }

    let pc_plus_4 : logic<32> = pc + 32'd4;
    let branch_tgt: logic<32> = pc + imm;
    var next_pc   : logic<32>;
    always_comb {
        case opcode {
            Opcode::Jal   : next_pc = branch_tgt;
            Opcode::Jalr  : next_pc = {alu_out[31:1], 1'b0};
            Opcode::Branch: next_pc = if take ? branch_tgt : pc_plus_4;
            default       : next_pc = pc_plus_4;
        }
    }
    // 跳到不是 4 的倍數的位址（沒有 C 擴充）：例外。jal / jalr 不用等比較器；
    // 分支的目標是 pc + imm，所以只看 imm[1]，再和 take 合起來（分支不寫暫存器和記憶體）
    // 位址的低兩位元：rs1 + imm 的 2 位元加法（不用等 32 位元的 ALU）
    let addr_lo   : logic<2> = rs1_data[1:0] + imm[1:0];
    let bad_jal   : logic = (opcode == Opcode::Jal && imm[1]) || (opcode == Opcode::Jalr && addr_lo[1]);
    let bad_branch: logic = opcode == Opcode::Branch && imm[1] && take;

    // --- 控制與狀態暫存器（CSR，machine mode）---
    var st_mie  : logic    ; // mstatus.MIE：全域中斷致能
    var st_mpie : logic    ; // mstatus.MPIE：進入陷阱前的 MIE
    var ie_msie : logic    ; // mie.MSIE / MTIE / MEIE
    var ie_mtie : logic    ;
    var ie_meie : logic    ;
    var mtvec   : logic<32>;
    var mscratch: logic<32>;
    var mepc    : logic<32>;
    var mcause  : logic<5> ; // {interrupt, code}：只有這些原因
    var minstret: logic<32>;

    let csr_addr: logic<12> = ir[31:20];
    // 先把位址換成編號（小的比較器），再用編號選值（窄的多工器）
    var csr_idx : logic<4> ;
    var csr_ok  : logic    ;
    always_comb {
        csr_ok = 1'b1;
        case csr_addr {
            12'h300                  : csr_idx = 4'd0; // mstatus（MPP 永遠是 M）
            12'h301                  : csr_idx = 4'd1; // misa
            12'h304                  : csr_idx = 4'd2; // mie
            12'h305                  : csr_idx = 4'd3; // mtvec
            12'h340                  : csr_idx = 4'd4; // mscratch
            12'h341                  : csr_idx = 4'd5; // mepc
            12'h342                  : csr_idx = 4'd6; // mcause
            12'h343                  : csr_idx = 4'd7; // mtval
            12'h344                  : csr_idx = 4'd8; // mip
            12'hB00, 12'hC00, 12'hC01: csr_idx = 4'd9; // mcycle / cycle / time：都是 SoC 的 mtime（寫入忽略）
            12'hB80, 12'hC80, 12'hC81: csr_idx = 4'd10;
            12'hB02, 12'hC02         : csr_idx = 4'd11; // minstret / instret（32 bit，寫入忽略）
            12'hB82, 12'hC82, 12'hF11, 12'hF12, 12'hF13, 12'hF14: csr_idx = 4'd12; // 0
            default: {
                csr_idx = 4'd12;
                csr_ok  = 1'b0;
            }
        }
    }
    var csr_old: logic<32>;
    always_comb {
        case csr_idx {
            4'd0   : csr_old = {19'd0, 2'b11, 3'd0, st_mpie, 3'd0, st_mie, 3'd0};
            4'd1   : csr_old = 32'h4000_1101; // RV32 I M A
            4'd2   : csr_old = {20'd0, ie_meie, 3'd0, ie_mtie, 3'd0, ie_msie, 3'd0};
            4'd3   : csr_old = mtvec;
            4'd4   : csr_old = mscratch;
            4'd5   : csr_old = mepc;
            4'd6   : csr_old = {mcause[4], 27'd0, mcause[3:0]};
            4'd7   : csr_old = 32'd0; // mtval：唯讀 0（規格允許）
            4'd8   : csr_old = {20'd0, i_irq_ext, 3'd0, i_irq_timer, 3'd0, i_irq_soft, 3'd0};
            4'd9   : csr_old = i_mtime[31:0];
            4'd10  : csr_old = i_mtime[63:32];
            4'd11  : csr_old = minstret;
            default: csr_old = 32'd0;
        }
    }
    // csrrw(i) 一定寫入；csrrs(i) / csrrc(i) 在 rs1 / zimm 不是 0 時才寫
    let csr_writes: logic     = funct3[1:0] == 2'b01 || rs1_idx != 5'd0;
    let csr_bad   : logic     = !csr_ok || (csr_addr[11:10] == 2'b11 && csr_writes);
    let csr_src   : logic<32> = if funct3[2] ? {27'd0, rs1_idx} : rs1_data;
    var csr_new   : logic<32>;
    always_comb {
        case funct3[1:0] {
            2'b01  : csr_new = csr_src;
            2'b10  : csr_new = csr_old | csr_src;
            default: csr_new = csr_old & ~csr_src;
        }
    }

    // --- 合法的指令（其他都是 illegal instruction 例外）：Decode 那一拍判斷，存進 legal_r；
    //     CSR 位址合不合法在 Exec 看（csr_bad）---
    let c_f3 : logic<3> = cur[14:12];
    let c_f7 : logic<7> = cur[31:25];
    let c_f5 : logic<5> = cur[31:27];
    var legal_d: logic;
    always_comb {
        case c_op {
            Opcode::Lui, Opcode::Auipc, Opcode::Jal: legal_d = 1'b1;
            Opcode::Jalr                           : legal_d = c_f3 == 3'd0;
            Opcode::Branch                         : legal_d = c_f3 != 3'd2 && c_f3 != 3'd3;
            Opcode::Load                           : legal_d = c_f3 != 3'd3 && c_f3 != 3'd6 && c_f3 != 3'd7;
            Opcode::Store                          : legal_d = c_f3 <: 3'd3;
            Opcode::IType                          : legal_d = if c_f3 == 3'd1 ? c_f7 == 7'd0 : if c_f3 == 3'd5 ? (c_f7 == 7'd0 || c_f7 == 7'h20) : 1'b1;
            Opcode::RType                          : legal_d = c_f7 == 7'd0 || c_f7 == 7'd1 || (c_f7 == 7'h20 && (c_f3 == 3'd0 || c_f3 == 3'd5));
            default: {
                if c_op == 7'b0001111 {
                    legal_d = c_f3 <: 3'd2;
                } else if c_op == 7'b1110011 {
                    legal_d = if c_f3 == 3'd0 ? (cur == 32'h0000_0073 || cur == 32'h0010_0073 || cur == 32'h3020_0073 || cur == 32'h1050_0073) : c_f3 != 3'd4;
                } else if c_op == 7'b0101111 {
                    legal_d = c_f3 == 3'd2 && (c_f5 == 5'b00010 || c_f5 == 5'b00011 || c_f5 == 5'b00001 || c_f5 == 5'b00000 || c_f5 == 5'b00100 || c_f5 == 5'b01100 || c_f5 == 5'b01000 || c_f5 == 5'b10000 || c_f5 == 5'b10100 || c_f5 == 5'b11000 || c_f5 == 5'b11100);
                } else {
                    legal_d = 1'b0;
                }
            }
        }
    }
    var legal_r: logic;
    let legal  : logic = legal_r && !(is_csr && csr_bad);

    // --- 中斷：外部 > 軟體 > 計時器 ---
    let pend_ext  : logic = i_irq_ext && ie_meie;
    let pend_soft : logic = i_irq_soft && ie_msie;
    let pend_timer: logic = i_irq_timer && ie_mtie;
    let pending   : logic = pend_ext || pend_soft || pend_timer;
    let irq       : logic = st_mie && pending;

    // --- 位址沒對齊 ---
    let mis_load : logic = (op_load && ((funct3[1:0] == 2'b10 && addr_lo != 2'd0) || (funct3[1:0] == 2'b01 && addr_lo[0]))) || (is_lr && addr_lo != 2'd0);
    let mis_store: logic = (op_store && ((funct3 == 3'd2 && addr_lo != 2'd0) || (funct3 == 3'd1 && addr_lo[0]))) || ((is_sc || is_amo) && addr_lo != 2'd0);

    // --- 陷阱（在 Exec 決定；陷入的指令不產生任何效果）---
    // trap_fast：不用等分支比較器的陷阱（決定暫存器、記憶體、CSR 寫不寫）；
    // trap = 再加上分支目標沒對齊（只決定下一個 pc）
    var trap_fast : logic   ;
    var trap_cause: logic<5>; // {interrupt, code}
    always_comb {
        trap_fast  = 1'b1;
        trap_cause = 5'd0;
        if irq {
            trap_cause = {1'b1, if pend_ext ? 4'd11 : if pend_soft ? 4'd3 : 4'd7};
        } else if !legal {
            trap_cause = 5'd2;
        } else if is_ecall {
            trap_cause = 5'd11;
        } else if is_ebreak {
            trap_cause = 5'd3;
        } else if mis_load {
            trap_cause = 5'd4;
        } else if mis_store {
            trap_cause = 5'd6;
        } else if bad_jal {
            trap_cause = 5'd0;
        } else {
            trap_fast = 1'b0;
        }
    }
    let trap: logic = trap_fast || bad_branch;

    // --- 乘除法（反覆式，33 拍：32 次移位加 / 移位減，最後一拍修正正負號）---
    var md_p  : logic<64>; // 乘：{部分積, 乘數}；除：{餘數, 商}
    var md_b  : logic<32>; // |被乘數| 或 |除數|
    var md_cnt: logic<6> ;
    var md_f3 : logic<3> ;
    var md_neg: logic    ;
    var md_bz : logic    ;

    let md_sa  : logic     = (funct3 == 3'd1 || funct3 == 3'd2 || funct3 == 3'd4 || funct3 == 3'd6) && rs1_data[31];
    let md_sb  : logic     = (funct3 == 3'd1 || funct3 == 3'd4 || funct3 == 3'd6) && rs2_data[31];
    let md_absa: logic<32> = if md_sa ? 32'd0 - rs1_data : rs1_data;
    let md_absb: logic<32> = if md_sb ? 32'd0 - rs2_data : rs2_data;

    // 一個 33 位元加減法器：乘法加 md_b（乘數這位是 1 時），除法從左移後的餘數減 md_b
    let md_sh  : logic<64> = {md_p[62:0], 1'b0};
    let md_div : logic     = md_f3[2];
    let md_x   : logic<33> = {1'b0, if md_div ? md_sh[63:32] : md_p[63:32]};
    let md_y   : logic<33> = if md_div ? ~{1'b0, md_b} : if md_p[0] ? {1'b0, md_b} : 33'd0;
    let md_sum : logic<33> = md_x + md_y + {32'd0, md_div}; // 減法 = 加上反相再加一
    let md_diff: logic<33> = md_sum;
    // 結果：先選低半或高半，再一起取負（乘積的高半取負 = ~高半 + (低半 == 0)）
    let md_hi  : logic     = md_f3 == 3'd1 || md_f3 == 3'd2 || md_f3 == 3'd3 || md_f3 == 3'd6 || md_f3 == 3'd7;
    let md_sel : logic<32> = if md_hi ? md_p[63:32] : md_p[31:0];
    let md_cin : logic     = if md_f3[2] ? 1'b1 : md_f3 == 3'd0 || md_p[31:0] == 32'd0;
    let md_sgn : logic<32> = if md_neg ? ~md_sel + {31'd0, md_cin} : md_sel;
    var md_res : logic<32>;
    always_comb {
        if md_bz && md_f3[2:1] == 2'b10 {
            md_res = 32'hffff_ffff; // 除以 0：商 = -1（餘數自然就是被除數）
        } else {
            md_res = md_sgn;
        }
    }

    // --- 寫回 ---
    var wb_data: logic<32>;
    always_comb {
        case opcode {
            Opcode::Jal, Opcode::Jalr: wb_data = pc_plus_4;
            Opcode::Lui              : wb_data = imm;
            Opcode::Auipc            : wb_data = branch_tgt;
            default                  : wb_data = if is_csr ? csr_old : alu_out;
        }
    }
    let writes: logic = (opcode == Opcode::RType && !muldiv) || opcode == Opcode::IType || opcode == Opcode::Jal || opcode == Opcode::Jalr || opcode == Opcode::Lui || opcode == Opcode::Auipc || is_csr;

    // --- load：從讀出的字取出 byte / halfword ---
    let load_word: logic<32> = i_rdata >> {lsaddr[1:0], 3'b000};
    var load_data: logic<32>;
    always_comb {
        case funct3 {
            3'b000 : load_data = {load_word[7] repeat 24, load_word[7:0]};
            3'b001 : load_data = {load_word[15] repeat 16, load_word[15:0]};
            3'b100 : load_data = {24'd0, load_word[7:0]};
            3'b101 : load_data = {16'd0, load_word[15:0]};
            default: load_data = load_word;
        }
    }

    // --- AMO：讀出的舊值和 rs2 算出新值（Mem 那一拍寫回）---
    // min / max：一個比較器（有號時把最高位元反相），funct5[2] = max，funct5[3] = 無號
    let amo_x  : logic<32> = {i_rdata[31] ^ !funct5[3], i_rdata[30:0]};
    let amo_y  : logic<32> = {rs2_data[31] ^ !funct5[3], rs2_data[30:0]};
    let amo_old: logic     = (amo_x <: amo_y) ^ funct5[2]; // 選舊值
    var amo_new: logic<32>;
    always_comb {
        case funct5 {
            5'b00001: amo_new = rs2_data; // swap
            5'b00000: amo_new = i_rdata + rs2_data;
            5'b00100: amo_new = i_rdata ^ rs2_data;
            5'b01100: amo_new = i_rdata & rs2_data;
            5'b01000: amo_new = i_rdata | rs2_data;
            default : amo_new = if amo_old ? i_rdata : rs2_data; // min / max / minu / maxu
        }
    }

    // --- store：資料複製到每個位元組位置，加上 byte strobe ---
    var store_data: logic<32>;
    var store_strb: logic<4> ;
    always_comb {
        case funct3 {
            3'b000: {
                store_data = {rs2_data[7:0] repeat 4};
                store_strb = 4'b0001 << addr_lo;
            }
            3'b001: {
                store_data = {rs2_data[15:0] repeat 2};
                store_strb = 4'b0011 << addr_lo;
            }
            default: {
                store_data = rs2_data;
                store_strb = 4'b1111;
            }
        }
    }

    // --- LR / SC 的保留 ---
    var resv_v : logic    ;
    var resv_a : logic<32>;
    let sc_ok  : logic     = resv_v && resv_a == rs1_data; // A 擴充的位址就是 rs1（不經過 ALU，路徑短）

    // Exec 之後的 pc：陷阱 → mtvec，mret → mepc
    let reads_mem: logic     = op_load || is_lr || is_amo;
    // Exec 送出的下一個讀取位址：不等陷阱（陷入時改走 Fetch，從 mtvec 重新取指令）；
    // 分支條件 take 只進最後一個多工器（其他的選擇先做好）
    let taken    : logic     = opcode == Opcode::Branch && take;
    var other_pc : logic<32>;
    always_comb {
        case opcode {
            Opcode::Jal : other_pc = branch_tgt;
            Opcode::Jalr: other_pc = {alu_out[31:1], 1'b0};
            default     : other_pc = if is_mret ? mepc : pc_plus_4;
        }
    }
    let exec_pc  : logic<32> = if taken ? branch_tgt : other_pc;
    let exec_rd  : logic<32> = if reads_mem ? alu_out : other_pc; // 不是分支時的讀取位址

    // --- 狀態機與記憶體埠 ---
    always_comb {
        o_re    = 1'b0;
        o_raddr = pc;
        o_waddr = alu_out;
        o_wdata = store_data;
        o_wstrb = 4'd0;
        rf_we   = 1'b0;
        rf_wd   = wb_data;
        if i_run {
            case state {
                FETCH: o_re = 1'b1;
                EXEC : {
                    // 陷入的 load 不讀（周邊的讀取有副作用）
                    o_raddr = if taken ? branch_tgt : exec_rd;
                    if reads_mem {
                        o_re = !trap_fast;
                    } else if !muldiv && !(is_wfi && !pending) {
                        o_re = 1'b1;
                    }
                    if !trap_fast {
                        o_wstrb = if op_store || (is_sc && sc_ok) ? store_strb : 4'd0;
                        rf_we   = (writes || is_sc) && rd_idx != 5'd0;
                        rf_wd   = if is_sc ? {31'd0, !sc_ok} : wb_data;
                    }
                }
                MEM: {
                    o_re    = 1'b1;
                    rf_we   = rd_idx != 5'd0;
                    rf_wd   = load_data; // LR / AMO 的 funct3 是 2：整個字
                    o_waddr = lsaddr;
                    o_wdata = amo_new;
                    o_wstrb = if is_amo ? 4'b1111 : 4'd0;
                }
                MULDIV: if md_cnt == 6'd32 {
                    o_re  = 1'b1;
                    rf_we = rd_idx != 5'd0;
                    rf_wd = md_res;
                }
                WFI    : o_re = pending;
                default: {}
            }
        }
    }

    let exec   : logic = i_run && state == EXEC;
    let csr_we : logic = exec && !trap_fast && is_csr && csr_writes;
    let retired: logic = exec && !trap;

    always_ff {
        if_reset {
            state    = FETCH;
            pc       = 32'd0;
            ir       = 32'd0;
            imm      = 32'd0;
            legal_r  = 1'b0;
            rs1_zero = 1'b1;
            rs2_zero = 1'b1;
            lsaddr   = 32'd0;
            st_mie   = 1'b0;
            st_mpie  = 1'b0;
            ie_msie  = 1'b0;
            ie_mtie  = 1'b0;
            ie_meie  = 1'b0;
            mtvec    = 32'd0;
            mscratch = 32'd0;
            mepc     = 32'd0;
            mcause   = 5'd0;
            md_p     = 64'd0;
            md_b     = 32'd0;
            md_cnt   = 6'd0;
            md_f3    = 3'd0;
            md_neg   = 1'b0;
            md_bz    = 1'b0;
            resv_v   = 1'b0;
            resv_a   = 32'd0;
        } else if !i_run {
            state = FETCH;
            pc    = 32'd0;
        } else {
            case state {
                FETCH : state = DECODE;
                DECODE: {
                    ir      = i_rdata;
                    imm      = imm_d;
                    legal_r  = legal_d;
                    rs1_zero = cur[19:15] == 5'd0;
                    rs2_zero = cur[24:20] == 5'd0;
                    state   = EXEC;
                }
                EXEC: {
                    lsaddr = alu_out;
                    pc     = exec_pc;
                    if trap {
                        mepc    = pc;
                        mcause  = if trap_fast ? trap_cause : 5'd0;
                        st_mpie = st_mie;
                        st_mie  = 1'b0;
                        resv_v  = 1'b0;
                        pc      = {mtvec[31:2], 2'b00};
                        state   = FETCH;
                    } else {
                        if is_mret {
                            st_mie  = st_mpie;
                            st_mpie = 1'b1;
                        }
                        if is_sc {
                            resv_v = 1'b0;
                        }
                        if csr_we {
                            case csr_idx {
                                4'd0: {
                                    st_mie  = csr_new[3];
                                    st_mpie = csr_new[7];
                                }
                                4'd2: {
                                    ie_msie = csr_new[3];
                                    ie_mtie = csr_new[7];
                                    ie_meie = csr_new[11];
                                }
                                4'd3   : mtvec    = {csr_new[31:2], 2'b00};
                                4'd4   : mscratch = csr_new;
                                4'd5   : mepc     = {csr_new[31:2], 2'b00};
                                4'd6   : mcause   = {csr_new[31], csr_new[3:0]};
                                default: {}
                            }
                        }
                        if muldiv {
                            md_p   = {32'd0, if funct3[2] ? md_absa : md_absb};
                            md_b   = if funct3[2] ? md_absb : md_absa;
                            md_cnt = 6'd0;
                            md_f3  = funct3;
                            md_neg = if funct3 == 3'd6 ? md_sa : md_sa ^ md_sb;
                            md_bz  = rs2_data == 32'd0;
                            state  = MULDIV;
                        } else if reads_mem {
                            state = MEM;
                        } else if is_wfi && !pending {
                            state = WFI;
                        } else {
                            state = DECODE;
                        }
                    }
                }
                MEM: {
                    if is_lr {
                        resv_v = 1'b1;
                        resv_a = lsaddr;
                    }
                    state = DECODE; // 下一個指令的讀取已經送出
                }
                MULDIV: {
                    if md_cnt == 6'd32 {
                        state = DECODE;
                    } else {
                        md_cnt = md_cnt + 6'd1;
                        if md_f3[2] {
                            md_p = if md_diff[32] ? md_sh : {md_diff[31:0], md_sh[31:1], 1'b1};
                        } else {
                            md_p = {md_sum, md_p[31:1]};
                        }
                    }
                }
                WFI: if pending {
                    state = DECODE;
                }
                default: state = FETCH;
            }
        }
    }

    // minstret：每個完成的指令加一（mcycle / time 讀的是 SoC 的 mtime）
    always_ff {
        if_reset {
            minstret = 32'd0;
        } else if retired {
            minstret = minstret + 32'd1;
        }
    }
}

// 8 KB 記憶體：四個 8 bit 寬的位元組通道，store 依 byte strobe 只寫部分通道
module RvMem #(
    param AW: u32 = 11, // 字位址寬度（2^AW 個 32 bit 字）
) (
    i_clk  : input  clock    ,
    i_re   : input  logic    ,
    i_raddr: input  logic<AW>,
    o_rdata: output logic<32>,
    i_wstrb: input  logic<4> ,
    i_waddr: input  logic<AW>,
    i_wdata: input  logic<32>,
) {
    inst b0: SyncRam #(ADDR_W: AW, DATA_W: 8) (i_clk, i_we: i_wstrb[0], i_waddr, i_wdata: i_wdata[7:0], i_re, i_raddr, o_rdata: o_rdata[7:0]);
    inst b1: SyncRam #(ADDR_W: AW, DATA_W: 8) (i_clk, i_we: i_wstrb[1], i_waddr, i_wdata: i_wdata[15:8], i_re, i_raddr, o_rdata: o_rdata[15:8]);
    inst b2: SyncRam #(ADDR_W: AW, DATA_W: 8) (i_clk, i_we: i_wstrb[2], i_waddr, i_wdata: i_wdata[23:16], i_re, i_raddr, o_rdata: o_rdata[23:16]);
    inst b3: SyncRam #(ADDR_W: AW, DATA_W: 8) (i_clk, i_we: i_wstrb[3], i_waddr, i_wdata: i_wdata[31:24], i_re, i_raddr, o_rdata: o_rdata[31:24]);
}

// CPU + 記憶體 + 周邊。i_ld = 1 時 CPU 停住，記憶體埠交給載入埠（testbench 用來放程式、讀結果）
module RvSoc #(
    param MEM_AW: u32 = 11 , // 2^MEM_AW 個字（11 = 8 KB）
    param CPB   : u32 = 104, // UART 每位元時脈數（12 MHz / 115200）
) (
    i_clk     : input  clock        ,
    i_rst     : input  reset        ,
    i_ld      : input  logic        ,
    i_ld_we   : input  logic        ,
    i_ld_addr : input  logic<MEM_AW>,
    i_ld_wdata: input  logic<32>    ,
    o_ld_rdata: output logic<32>    ,
    i_btn     : input  logic<3>     ,
    i_sw      : input  logic<8>     ,
    i_rx      : input  logic        ,
    o_tx      : output logic        ,
    o_led     : output logic<8>     ,
    o_xwe     : output logic        , // 寫到 0x1000_2000 以上：給外加的周邊
    o_xaddr   : output logic<14>    , // 位址的 bit 15..2
    o_xdata   : output logic<32>    ,
) {
    var raddr: logic<32>;
    var re   : logic    ;
    var rdata: logic<32>;
    var waddr: logic<32>;
    var wstrb: logic<4> ;
    var wdata: logic<32>;

    var mtime   : logic<32>;
    var mtimecmp: logic<32>;
    var msip    : logic    ;
    var rx_full : logic    ;

    inst u_cpu: RvCore (
        i_clk      : i_clk              ,
        i_rst      : i_rst              ,
        i_run      : !i_ld              ,
        o_raddr    : raddr              ,
        o_re       : re                 ,
        i_rdata    : rdata              ,
        o_waddr    : waddr              ,
        o_wstrb    : wstrb              ,
        o_wdata    : wdata              ,
        i_irq_timer: mtime >= mtimecmp  ,
        i_irq_soft : msip               ,
        i_irq_ext  : rx_full            ,
        i_mtime    : {32'd0, mtime}     ,
    );

    // --- 記憶體（載入埠優先）---
    let io_r: logic = raddr[28];
    let io_w: logic = waddr[28];
    var mem_rdata: logic<32>;
    inst u_mem: RvMem #(AW: MEM_AW) (
        i_clk  : i_clk                                                 ,
        i_re   : i_ld || (re && !io_r)                                 ,
        i_raddr: if i_ld ? i_ld_addr : raddr[MEM_AW + 1:2]             ,
        o_rdata: mem_rdata                                             ,
        i_wstrb: if i_ld ? {i_ld_we repeat 4} : if io_w ? 4'd0 : wstrb,
        i_waddr: if i_ld ? i_ld_addr : waddr[MEM_AW + 1:2]             ,
        i_wdata: if i_ld ? i_ld_wdata : wdata                          ,
    );
    assign o_ld_rdata = mem_rdata;

    // --- 周邊 ---
    var led    : logic<8> ;
    var btn_s  : logic<3> ;
    var sw_s   : logic<8> ;
    var rx_s   : logic<2> ;
    var rx_byte: logic<8> ;
    var tx_go  : logic    ;
    var tx_byte: logic<8> ;
    var tx_rdy : logic    ;
    var rx_v   : logic    ;
    var rx_d   : logic<8> ;
    var io_sel : logic    ; // 上一拍讀的是周邊
    var io_data: logic<32>;

    inst u_tx: UartTx #(CLKS_PER_BIT: CPB) (
        i_clk  : i_clk  ,
        i_rst  : i_rst  ,
        i_valid: tx_go  ,
        i_data : tx_byte,
        o_ready: tx_rdy ,
        o_tx   : o_tx   ,
    );
    inst u_rx: UartRx #(CLKS_PER_BIT: CPB) (
        i_clk  : i_clk  ,
        i_rst  : i_rst  ,
        i_rx   : rx_s[1],
        o_valid: rx_v   ,
        o_data : rx_d   ,
    );

    let wr_any: logic = !i_ld && io_w && wstrb != 4'd0;
    let wr_io : logic = wr_any && waddr[15:13] == 3'd0;
    assign o_xwe   = wr_any && waddr[15:13] != 3'd0;
    assign o_xaddr = waddr[15:2];
    assign o_xdata = wdata;
    let rd_io: logic = !i_ld && re && io_r;

    always_ff {
        if_reset {
            led      = 0;
            mtime    = 0;
            mtimecmp = 32'hffff_ffff;
            msip     = 0;
            btn_s   = 0;
            sw_s    = 0;
            rx_s    = 2'b11;
            rx_byte = 0;
            rx_full = 0;
            tx_go   = 0;
            tx_byte = 0;
            io_sel  = 0;
            io_data = 0;
        } else {
            mtime = mtime + 32'd1;
            btn_s = i_btn;
            sw_s  = i_sw;
            rx_s  = {rx_s[0], i_rx};
            tx_go = 0;
            if wr_io {
                case waddr[5:2] {
                    4'd0: led = wdata[7:0];
                    4'd2: {
                        tx_go   = 1;
                        tx_byte = wdata[7:0];
                    }
                    4'd4   : mtime    = wdata;
                    4'd6   : mtimecmp = wdata;
                    4'd8   : msip     = wdata[0];
                    default: {}
                }
            }
            if rx_v {
                rx_byte = rx_d;
                rx_full = 1;
            } else if rd_io && raddr[5:2] == 4'd2 {
                rx_full = 0;
            }
            io_sel = rd_io;
            if rd_io {
                case raddr[5:2] {
                    4'd0   : io_data = {24'd0, led};
                    4'd1   : io_data = {16'd0, sw_s, 5'd0, btn_s};
                    4'd2   : io_data = {24'd0, rx_byte};
                    4'd3   : io_data = {30'd0, rx_full, !tx_rdy || tx_go};
                    4'd4   : io_data = mtime;
                    4'd6   : io_data = mtimecmp;
                    4'd8   : io_data = {31'd0, msip};
                    default: io_data = 32'd0;
                }
            }
        }
    }

    assign rdata = if io_sel ? io_data : mem_rdata;
    assign o_led = led;
}

// FPGA 頂層：iCEBreaker（BTN_N 重設，BTN1-3，USB 序列埠，PMOD1A 的 8 個輸出（LED 模組、七段顯示器…），
// PMOD1B 的 8 個輸入（開關模組））。
// 程式放在 block RAM 的初值裡（veryl-eda 把程式寫進位元流）
module RvBoard (
    i_clk: input  clock   ,
    i_rst: input  reset   ,
    i_btn: input  logic<3>,
    i_sw : input  logic<8>,
    i_rx : input  logic   ,
    o_tx : output logic   ,
    o_led: output logic<8>,
) {
    inst u_soc: RvSoc (
        i_clk     : i_clk,
        i_rst     : i_rst,
        i_ld      : 1'b0 ,
        i_ld_we   : 1'b0 ,
        i_ld_addr : 11'd0,
        i_ld_wdata: 32'd0,
        o_ld_rdata: _    ,
        i_btn     : i_btn,
        i_sw      : i_sw ,
        i_rx      : i_rx ,
        o_tx      : o_tx ,
        o_led     : o_led,
        o_xwe     : _    ,
        o_xaddr   : _    ,
        o_xdata   : _    ,
    );
}

// 測試：把 rv32i_test.S（資料在 0x300，rvsoc_rom.veryl）載入 1 KB 的記憶體、執行，再讀回簽章
// （閘級模擬時記憶體是一個個正反器，所以測試用小的記憶體）
#[test(test_rvsoc)]
module TestRvSoc {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var ld      : logic    ;
    var ld_we   : logic    ;
    var ld_addr : logic<8> ;
    var ld_rdata: logic<32>;
    var prog    : logic<32>;
    var tx      : logic    ;
    var led     : logic<8> ;

    inst u_prog: RvTestProg (
        i_addr: {22'd0, ld_addr, 2'b00},
        o_inst: prog                    ,
    );

    inst dut: RvSoc #(MEM_AW: 8, CPB: 4) (
        i_clk     : clk     ,
        i_rst     : rst     ,
        i_ld      : ld      ,
        i_ld_we   : ld_we   ,
        i_ld_addr : ld_addr ,
        i_ld_wdata: prog    ,
        o_ld_rdata: ld_rdata,
        i_btn     : 3'd0    ,
        i_sw      : 8'd0    ,
        i_rx      : 1'b1    ,
        o_tx      : tx      ,
        o_led     : led     ,
        o_xwe     : _       ,
        o_xaddr   : _       ,
        o_xdata   : _       ,
    );

    initial {
        // 1. 載入程式（256 個字）
        ld      = 1;
        ld_we   = 1;
        ld_addr = 0;
        rst.assert();
        for _i in 0..256 {
            clk.next();
            ld_addr = ld_addr + 8'd1;
        }
        // 2. 執行
        ld_we = 0;
        ld    = 0;
        clk.next(1000);
        // 3. 讀回 0x1000 起的簽章（同步讀取：下一拍才有資料）
        ld = 1;
        ld_addr = 8'd239; clk.next(); $assert(ld_rdata == 32'h00000001, "program finished");
        ld_addr = 8'd192; clk.next(); $assert(ld_rdata == 32'h12345678, "lui + addi");
        ld_addr = 8'd193; clk.next(); $assert(ld_rdata == 32'h00000010, "auipc");
        ld_addr = 8'd194; clk.next(); $assert(ld_rdata == 32'hffffffff, "lui + srai");
        ld_addr = 8'd195; clk.next(); $assert(ld_rdata == 32'hfffffffb, "add");
        ld_addr = 8'd196; clk.next(); $assert(ld_rdata == 32'h0000000b, "sub");
        ld_addr = 8'd197; clk.next(); $assert(ld_rdata == 32'hffffffc0, "sll");
        ld_addr = 8'd198; clk.next(); $assert(ld_rdata == 32'h1fffffff, "srl");
        ld_addr = 8'd199; clk.next(); $assert(ld_rdata == 32'hffffffff, "sra");
        ld_addr = 8'd200; clk.next(); $assert(ld_rdata == 32'hc0000000, "slli");
        ld_addr = 8'd201; clk.next(); $assert(ld_rdata == 32'h0000000f, "srli");
        ld_addr = 8'd202; clk.next(); $assert(ld_rdata == 32'hfffffffc, "srai");
        ld_addr = 8'd203; clk.next(); $assert(ld_rdata == 32'hedcba980, "xor");
        ld_addr = 8'd204; clk.next(); $assert(ld_rdata == 32'hfffffffc, "xori");
        ld_addr = 8'd205; clk.next(); $assert(ld_rdata == 32'h1234567b, "or");
        ld_addr = 8'd206; clk.next(); $assert(ld_rdata == 32'h000007f3, "ori");
        ld_addr = 8'd207; clk.next(); $assert(ld_rdata == 32'h12345678, "and");
        ld_addr = 8'd208; clk.next(); $assert(ld_rdata == 32'h00000078, "andi");
        ld_addr = 8'd209; clk.next(); $assert(ld_rdata == 32'h00000001, "slt");
        ld_addr = 8'd210; clk.next(); $assert(ld_rdata == 32'h00000000, "sltu");
        ld_addr = 8'd211; clk.next(); $assert(ld_rdata == 32'h00000000, "slti");
        ld_addr = 8'd212; clk.next(); $assert(ld_rdata == 32'h00000001, "sltiu");
        ld_addr = 8'd213; clk.next(); $assert(ld_rdata == 32'h00000006, "sll uses rs2[4:0]");
        ld_addr = 8'd214; clk.next(); $assert(ld_rdata == 32'h000000aa, "beq/bne/blt/bge");
        ld_addr = 8'd215; clk.next(); $assert(ld_rdata == 32'h0000000a, "bltu/bgeu");
        ld_addr = 8'd216; clk.next(); $assert(ld_rdata == 32'h0000000f, "backward branch loop");
        ld_addr = 8'd217; clk.next(); $assert(ld_rdata == 32'h00000000, "jal/jalr skip");
        ld_addr = 8'd218; clk.next(); $assert(ld_rdata == 32'h00000008, "jalr link");
        ld_addr = 8'd219; clk.next(); $assert(ld_rdata == 32'hfffffffc, "jal link");
        ld_addr = 8'd220; clk.next(); $assert(ld_rdata == 32'h00000078, "lb");
        ld_addr = 8'd221; clk.next(); $assert(ld_rdata == 32'h00000012, "lb offset 3");
        ld_addr = 8'd222; clk.next(); $assert(ld_rdata == 32'hfffffff8, "lb sign");
        ld_addr = 8'd223; clk.next(); $assert(ld_rdata == 32'h000000f8, "lbu");
        ld_addr = 8'd224; clk.next(); $assert(ld_rdata == 32'h00001234, "lh");
        ld_addr = 8'd225; clk.next(); $assert(ld_rdata == 32'hfffffff8, "lh sign");
        ld_addr = 8'd226; clk.next(); $assert(ld_rdata == 32'h0000ffff, "lhu");
        ld_addr = 8'd227; clk.next(); $assert(ld_rdata == 32'h00005678, "lhu offset 0");
        ld_addr = 8'd228; clk.next(); $assert(ld_rdata == 32'h12f80378, "sb");
        ld_addr = 8'd229; clk.next(); $assert(ld_rdata == 32'h0003fff8, "sh");
        ld_addr = 8'd230; clk.next(); $assert(ld_rdata == 32'h56785678, "sh both halves");
        ld_addr = 8'd231; clk.next(); $assert(ld_rdata == 32'h00000000, "x0 is zero");
        $finish();
    }
}
