#[test(test_rvsoc_ima)]
module TestRvSocIma {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var ld      : logic    ;
    var ld_we   : logic    ;
    var ld_addr : logic<9> ;
    var ld_rdata: logic<32>;
    var prog    : logic<32>;

    inst u_prog: RvTestProgIma (
        i_addr: {21'd0, ld_addr, 2'b00},
        o_inst: prog                    ,
    );

    inst dut: RvSoc #(MEM_AW: 9, CPB: 4) (
        i_clk: clk, i_rst: rst, i_ld: ld, i_ld_we: ld_we, i_ld_addr: ld_addr, i_ld_wdata: prog, o_ld_rdata: ld_rdata,
        i_btn: 3'd0, i_sw: 8'd0, i_rx: 1'b1, o_tx: _, o_led: _, o_xwe: _, o_xaddr: _, o_xdata: _,
    );

    initial {
        ld      = 1;
        ld_we   = 1;
        ld_addr = 0;
        rst.assert();
        for _i in 0..256 {
            clk.next();
            ld_addr = ld_addr + 9'd1;
        }
        ld_we = 0;
        ld    = 0;
        clk.next(3000);
        ld = 1;
        ld_addr = 9'd256; clk.next(); $assert(ld_rdata == 32'h5b32b782, "word 0");
        ld_addr = 9'd257; clk.next(); $assert(ld_rdata == 32'hffff911a, "word 1");
        ld_addr = 9'd258; clk.next(); $assert(ld_rdata == 32'h075b5e2f, "word 2");
        ld_addr = 9'd259; clk.next(); $assert(ld_rdata == 32'hffff911a, "word 3");
        ld_addr = 9'd260; clk.next(); $assert(ld_rdata == 32'h00000000, "word 4");
        ld_addr = 9'd261; clk.next(); $assert(ld_rdata == 32'hfffffffe, "word 5");
        ld_addr = 9'd262; clk.next(); $assert(ld_rdata == 32'h40000000, "word 6");
        ld_addr = 9'd263; clk.next(); $assert(ld_rdata == 32'h80000000, "word 7");
        ld_addr = 9'd264; clk.next(); $assert(ld_rdata == 32'hffffd7bb, "word 8");
        ld_addr = 9'd265; clk.next(); $assert(ld_rdata == 32'h0000001e, "word 9");
        ld_addr = 9'd266; clk.next(); $assert(ld_rdata == 32'h00000000, "word 10");
        ld_addr = 9'd267; clk.next(); $assert(ld_rdata == 32'h000f4243, "word 11");
        ld_addr = 9'd268; clk.next(); $assert(ld_rdata == 32'h00000000, "word 12");
        ld_addr = 9'd269; clk.next(); $assert(ld_rdata == 32'hffffff9f, "word 13");
        ld_addr = 9'd270; clk.next(); $assert(ld_rdata == 32'hffffffff, "word 14");
        ld_addr = 9'd271; clk.next(); $assert(ld_rdata == 32'hffffff9f, "word 15");
        ld_addr = 9'd272; clk.next(); $assert(ld_rdata == 32'hffffffff, "word 16");
        ld_addr = 9'd273; clk.next(); $assert(ld_rdata == 32'hffffff9f, "word 17");
        ld_addr = 9'd274; clk.next(); $assert(ld_rdata == 32'h80000000, "word 18");
        ld_addr = 9'd275; clk.next(); $assert(ld_rdata == 32'h00000000, "word 19");
        ld_addr = 9'd276; clk.next(); $assert(ld_rdata == 32'h00000064, "word 20");
        ld_addr = 9'd277; clk.next(); $assert(ld_rdata == 32'h00000000, "word 21");
        ld_addr = 9'd278; clk.next(); $assert(ld_rdata == 32'h00000001, "word 22");
        ld_addr = 9'd279; clk.next(); $assert(ld_rdata == 32'h00000007, "word 23");
        ld_addr = 9'd280; clk.next(); $assert(ld_rdata == 32'h00000007, "word 24");
        ld_addr = 9'd281; clk.next(); $assert(ld_rdata == 32'h0000000c, "word 25");
        ld_addr = 9'd282; clk.next(); $assert(ld_rdata == 32'h00000003, "word 26");
        ld_addr = 9'd283; clk.next(); $assert(ld_rdata == 32'h00000002, "word 27");
        ld_addr = 9'd284; clk.next(); $assert(ld_rdata == 32'h00000032, "word 28");
        ld_addr = 9'd285; clk.next(); $assert(ld_rdata == 32'hfffffffd, "word 29");
        ld_addr = 9'd286; clk.next(); $assert(ld_rdata == 32'h00000032, "word 30");
        ld_addr = 9'd287; clk.next(); $assert(ld_rdata == 32'h00000032, "word 31");
        ld_addr = 9'd288; clk.next(); $assert(ld_rdata == 32'hffffffff, "word 32");
        ld_addr = 9'd289; clk.next(); $assert(ld_rdata == 32'h00001234, "word 33");
        ld_addr = 9'd290; clk.next(); $assert(ld_rdata == 32'h00005a5a, "word 34");
        ld_addr = 9'd291; clk.next(); $assert(ld_rdata == 32'h00005a5a, "word 35");
        ld_addr = 9'd292; clk.next(); $assert(ld_rdata == 32'h00005afa, "word 36");
        ld_addr = 9'd293; clk.next(); $assert(ld_rdata == 32'h00005a0a, "word 37");
        ld_addr = 9'd294; clk.next(); $assert(ld_rdata == 32'h00000011, "word 38");
        ld_addr = 9'd295; clk.next(); $assert(ld_rdata == 32'h00000019, "word 39");
        ld_addr = 9'd296; clk.next(); $assert(ld_rdata == 32'h00000018, "word 40");
        ld_addr = 9'd297; clk.next(); $assert(ld_rdata == 32'h0000000b, "word 41");
        ld_addr = 9'd298; clk.next(); $assert(ld_rdata == 32'h00000280, "word 42");
        ld_addr = 9'd299; clk.next(); $assert(ld_rdata == 32'h00000080, "word 43");
        ld_addr = 9'd300; clk.next(); $assert(ld_rdata == 32'h00000088, "word 44");
        ld_addr = 9'd301; clk.next(); $assert(ld_rdata == 32'h00000003, "word 45");
        ld_addr = 9'd302; clk.next(); $assert(ld_rdata == 32'h00000294, "word 46");
        ld_addr = 9'd303; clk.next(); $assert(ld_rdata == 32'h00000080, "word 47");
        ld_addr = 9'd304; clk.next(); $assert(ld_rdata == 32'h00000002, "word 48");
        ld_addr = 9'd305; clk.next(); $assert(ld_rdata == 32'h00000298, "word 49");
        ld_addr = 9'd306; clk.next(); $assert(ld_rdata == 32'h00000080, "word 50");
        ld_addr = 9'd307; clk.next(); $assert(ld_rdata == 32'h00000002, "word 51");
        ld_addr = 9'd308; clk.next(); $assert(ld_rdata == 32'h0000029c, "word 52");
        ld_addr = 9'd309; clk.next(); $assert(ld_rdata == 32'h00000080, "word 53");
        ld_addr = 9'd310; clk.next(); $assert(ld_rdata == 32'h00000002, "word 54");
        ld_addr = 9'd311; clk.next(); $assert(ld_rdata == 32'h000002a0, "word 55");
        ld_addr = 9'd312; clk.next(); $assert(ld_rdata == 32'h00000080, "word 56");
        ld_addr = 9'd313; clk.next(); $assert(ld_rdata == 32'h00000005, "word 57");
        ld_addr = 9'd314; clk.next(); $assert(ld_rdata == 32'h00000001, "word 58");
        $finish();
    }
}
