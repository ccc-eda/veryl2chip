            10'h028 : o_inst = 32'h003fa023; // sw x3,0(x31)
            10'h02c : o_inst = 32'h004f8f93; // addi x31,x31,4
            10'h030 : o_inst = 32'h022091b3; // mulh x3,x1,x2
            10'h034 : o_inst = 32'h003fa023; // sw x3,0(x31)
