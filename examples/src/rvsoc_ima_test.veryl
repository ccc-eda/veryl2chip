// generated by examples/sw/build.sh from rv32ima_test.S -- do not edit
// the program (data at 0x400) and its expected results from spike, for RvSoc's RV32IMA + Zicsr
module RvTestProgIma (
    i_addr: input  logic<32>,
    o_inst: output logic<32>,
) {
    always_comb {
        case i_addr[9:0] {
            10'h000 : o_inst = 32'h00000fb7; // lui x31,0x0
            10'h004 : o_inst = 32'h400f8f93; // addi x31,x31,1024
            10'h008 : o_inst = 32'h00000097; // auipc x1,0x0
            10'h00c : o_inst = 32'h2b408093; // addi x1,x1,692
